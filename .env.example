# Copy to .env and replace placeholders with values for your own trusted lab.
# Never commit .env or real credentials.
WAZUH_INDEXER_URL=https://YOUR_INDEXER_HOST:9200
WAZUH_INDEXER_USER=YOUR_WAZUH_USER
WAZUH_INDEXER_PASSWORD=REPLACE_ME
WAZUH_VERIFY_SSL=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=soc_multi_agent
POSTGRES_USER=soc_app
POSTGRES_PASSWORD=REPLACE_ME

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_FAST_MODEL=qwen3.5:9b
# OLLAMA_REASONING_MODEL=qwen3.5:9b
